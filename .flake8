[flake8]
# black enforces 100 columns for code; 120 leaves room for long strings (CSS, prose, docstrings).
max-line-length = 120
extend-ignore = E203, W503
exclude = .git,__pycache__,.venv,build
per-file-ignores =
    # Streamlit entrypoint adjusts sys.path before importing the package
    src/app.py: E402
    scripts/*.py: E402
    # CSS blocks and literal data tables
    src/ui/theme.py: E501
    scripts/build_external_dataset.py: E501
    # covered by the pretrained-model digest: editing this file invalidates every saved model
    src/model_cache.py: F401
