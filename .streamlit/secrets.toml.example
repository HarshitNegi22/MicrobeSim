# Copy to .streamlit/secrets.toml (never commit the real file) and set MICROBESIM_AUTH_MODE=oidc.
# Streamlit's native OpenID Connect support; see https://docs.streamlit.io/develop/concepts/connections/authentication
[auth]
redirect_uri = "https://microbesim.example.com/oauth2callback"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-STRING"
client_id = "REPLACE-WITH-CLIENT-ID"
client_secret = "REPLACE-WITH-CLIENT-SECRET"
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"

# Who may enter (set as environment variables, not here):
#   MICROBESIM_AUTH_MODE=oidc
#   MICROBESIM_OIDC_ALLOWED_DOMAINS=yourcompany.com
#   MICROBESIM_OIDC_ALLOWED_EMAILS=contractor@partner.com
